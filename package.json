{
  "name": "pi-pet-emote",
  "version": "0.2.0",
  "description": "A single reactive pixel-art pet for Pi, driven by local session events with no model calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offluisangel/pi-pet-emote.git"
  },
  "homepage": "https://github.com/offluisangel/pi-pet-emote#readme",
  "bugs": {
    "url": "https://github.com/offluisangel/pi-pet-emote/issues"
  },
  "type": "module",
  "author": {
    "name": "offluisangel",
    "email": "offluisangel@gmail.com"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "sprites": "python3 -B scripts/sprites/build.py && node scripts/sprites/leo.ts",
    "scenes": "node scripts/sprites/scenes.ts",
    "pack:check": "node scripts/check-package.mjs",
    "check:generated": "node scripts/check-generated.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "gentle-shell",
    "pixel-art",
    "emote",
    "avatar",
    "tui"
  ],
  "files": [
    "src",
    "emotes",
    "docs/avatar.png",
    "config.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "image": "./docs/avatar.png",
    "extensions": ["./src/index.ts"]
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.5.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
